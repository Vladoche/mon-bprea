{
  "name": "mon-bprea",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:auth-sdk": "node scripts/build-auth-sdk.mjs",
    "build:privacy-notice": "node scripts/build-privacy-notice.mjs",
    "admin:auth-link": "node --env-file-if-exists=.env.supabase-test.local scripts/admin-generate-auth-link.mjs",
    "admin:auth-link:prod": "node --env-file-if-exists=.env.supabase-prod.local scripts/admin-generate-prod-auth-link.mjs",
    "dev-recipe:prepare": "node scripts/dev-recipe/prepare.mjs",
    "dev-recipe:continue": "node scripts/dev-recipe/prepare-continuation.mjs",
    "dev-recipe:session": "node scripts/dev-recipe/session.mjs",
    "maintenance:tmp": "node scripts/maintenance/tmp-prune.mjs",
    "maintenance:tmp:clean": "node scripts/maintenance/tmp-prune.mjs --apply",
    "delivery:complete": "node scripts/maintenance/tmp-prune.mjs --delivery",
    "preopening": "node scripts/preopening/operator.mjs",
    "preopening:notice": "node scripts/preopening/notice-preview.mjs",
    "preopening:exercise": "node scripts/preopening/exercise-local.mjs",
    "test": "vitest run --config tests/vitest.config.js",
    "test:watch": "vitest --config tests/vitest.config.js",
    "test:unit": "vitest run --config tests/vitest.config.js tests/unit",
    "test:integration": "vitest run --config tests/vitest.config.js tests/integration",
    "test:e2e": "playwright test --config tests/playwright.config.js",
    "test:supabase": "node --env-file-if-exists=.env.supabase-test.local scripts/test-supabase.mjs",
    "test:drill:supabase": "node --env-file-if-exists=.env.supabase-test.local scripts/test-drill-supabase.mjs",
    "test:personal:supabase": "node --env-file-if-exists=.env.supabase-test.local scripts/test-personal-data-supabase.mjs",
    "test:e2e:supabase": "playwright test --config tests/playwright.supabase.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "vitest": "5.0.5"
  }
}
