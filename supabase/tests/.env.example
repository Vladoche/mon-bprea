# Copier vers .env.supabase-test.local à la racine (ignoré par Git).
# Utiliser uniquement les valeurs de la stack CLI mon-bprea-lot6-1-local.
# SUPABASE_TEST_PUBLISHABLE_KEY : PUBLISHABLE_KEY, sinon ANON_KEY locale.
# SUPABASE_TEST_ADMIN_KEY : SECRET_KEY, sinon SERVICE_ROLE_KEY locale.
# Ne jamais utiliser des clés d'un projet hébergé, même de développement.
SUPABASE_TEST_CONFIRM_LOCAL=mon-bprea-lot6-1-local
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_MAIL_URL=http://127.0.0.1:54324
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_ADMIN_KEY=
